    "segments": [
      {
        "start": 4.919999999999996,
        "end": 7.36,
        "text": "Catch the dangerous action before it runs."
      },
      {
        "start": 11.18,
        "end": 16.92,
        "text": "Every action your unattended agent tries is intercepted and held here, risk-scored and"
      },
      {
        "start": 16.92,
        "end": 18.34,
        "text": "bound to the exact command."
      },
      {
        "start": 18.98,
        "end": 24.36,
        "text": "One click releases it, and the decision is recorded, chained to every governed action"
      },
      {
        "start": 24.36,
        "end": 24.92,
        "text": "that follows."
      },
      {
        "start": 25.720000000000002,
        "end": 30.22,
        "text": "One ledger, many lenses, every rule that governs your agents."
      },
      {
        "start": 38.3,
        "end": 42.42,
        "text": "Held before they run, risk-scored, one click to allow or deny."
      },
      {
        "start": 44.24,
        "end": 48.96,
        "text": "One ledger, chained to the decision, spend and risk-verified on the record."
      },
      {
        "start": 50.02,
        "end": 52.88,
        "text": "Govern your agents at dashclaw.io"
      }
    ],
