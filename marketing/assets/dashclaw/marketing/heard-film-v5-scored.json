    "segments": [
      {
        "start": 0.6000000000000008,
        "end": 3.34,
        "text": "At 3 in the morning, your agent is still working."
      },
      {
        "start": 6,
        "end": 9.8,
        "text": "It reads. It writes. It deploys. Nobody is watching."
      },
      {
        "start": 11.96,
        "end": 14.52,
        "text": "Until it reaches for something that cannot be undone."
      },
      {
        "start": 15.420000000000002,
        "end": 18.7,
        "text": "Dashclaw holds it. Risk scored. Bound to the exact command."
      },
      {
        "start": 19.18,
        "end": 20.84,
        "text": "Waiting for you. Wherever you are."
      },
      {
        "start": 22.16,
        "end": 25.52,
        "text": "One click. It runs. And the decision is on the record."
      },
      {
        "start": 27.1,
        "end": 30.74,
        "text": "Every governed action. Chained to the decision that allowed it."
      },
      {
        "start": 31.08,
        "end": 32.9,
        "text": "Not a log after the fact."
      },
      {
        "start": 34.64,
        "end": 36.98,
        "text": "Govern your agents at dashclaw.io"
      }
    ],
